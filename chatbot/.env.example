# Copy to chatbot/.env and fill in. Never commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Demo sign-in on Telegram: your user id (send /whoami to the bot), comma-separated
TELEGRAM_DEMO_USER_IDS=

# Origins allowed to call /chat from a browser (comma-separated), e.g. the TBL Hub domain
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Demo sign-in: the TBL Hub copy sends this token to load the fictional sample student
STUDENT_DEMO_TOKEN=demo-student
